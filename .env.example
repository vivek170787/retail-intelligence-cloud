# Copy this file to .env and fill in a real key before running retail_agent/runner.py,
# inventory_agent, or check_openai_connection.py.
# Never commit the real .env file.
OPENAI_API_KEY=sk-...your-key-here...

# Optional: overrides the model used by openai_config.py (and anything that
# reuses it, e.g. inventory_agent/llm_explainer.py). Defaults to "gpt-5.6-luna"
# if unset.
OPENAI_MODEL=gpt-5.6-luna
